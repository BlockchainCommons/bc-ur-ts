[
  {
    "name": "ESM root entry (import *), minified + gzipped",
    "path": "dist/index.mjs",
    "limit": "34 kB"
  },
  {
    "name": "bytewords subpath, minified + gzipped",
    "path": "dist/bytewords.mjs",
    "limit": "21 kB"
  },
  {
    "name": "fountain subpath, minified + gzipped",
    "path": "dist/fountain.mjs",
