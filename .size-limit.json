  {
    "name": "root entry, package's own code (crypto and dcbor external)",
    "path": "dist/index.mjs",
    "ignore": [
      "@blockchaincommons/crypto",
      "@blockchaincommons/dcbor"
    ],
    "limit": "8 kB"
  }
]
